# MongoDB — all text data (users, books, chapters, chats, shelves).
# Include the database name in the path.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# JWT session signing — generate with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic — powers the Studio (AI book creation). Server-side only.
ANTHROPIC_API_KEY=
# Optional: override the writing model (default: claude-haiku-4-5-20251001)
# BOOK_MODEL=
# Optional: the model that draws vector chapter illustrations (default: claude-opus-5)
# ILLUSTRATION_MODEL=

# xAI image generation (Grok Imagine) — book covers and chapter artwork. Optional:
# without it, books keep their generated typeset covers.
XAI_API_KEY=
# XAI_IMAGE_MODEL=

# Media storage: any S3-compatible bucket (uploaded covers, generated artwork).
# Optional for local testing; cover uploads answer "Media storage not configured" without it.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://media.your-domain.example"
# Optional: the bucket's region (default "auto")
# STORAGE_REGION=

# Public origin the app builds its own links from (invite links, the MCP
# connector URL, payment return URLs). Inlined at BUILD time by Next.
NEXT_PUBLIC_ORIGIN="http://localhost:3000"

# Stripe — Lectoire Plus, book sales, print orders and creator payouts (optional).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Narration — an external text-to-speech service speaking the Chanova Audio API.
# Leave either empty and narration is switched off. See lib/audiobook.ts for the contract.
CHANOVA_AUDIO_URL=
CHANOVA_AUDIO_KEY=

# Housekeeping (resumes stalled narrations, drawings and payouts). A production
# server runs it every 15 minutes on its own; set 0 to turn that off.
# HOUSEKEEPING_INTERVAL_MINUTES=15
# Guards POST /api/cron/narration, for running housekeeping from an external scheduler.
CRON_SECRET=

# Harakumo Mail — operational alerts to the team (contact form, paid orders,
# disputes). Create a key at Harakumo → Settings → API keys. Server-side only.
# Leave it empty and alerts are simply off.
HARAKUMO_API_KEY=
# HARAKUMO_BASE_URL=https://harakumo.com

# Public contact address shown in the footer, legal pages and password-reset page
# (read at build time for static pages). Empty: those pages point to the contact form.
CONTACT_EMAIL=
# Where team alerts go. Defaults to CONTACT_EMAIL; if both are empty, nothing is sent.
ADMIN_EMAIL=
